#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "bvh_defines.h"
#define VK_USED_BUILD_FLAGS (RADV_BUILD_FLAG_BVH8)
#include "bvh_helpers.h"

layout(push_constant) uniform CONSTS {
   copy_args args;
};

void
main(void)
{
   uint32_t global_id = gl_GlobalInvocationID.x;
   uint32_t lanes = gl_NumWorkGroups.x * 64;
   uint32_t increment = lanes * 16;

   uint64_t copy_src_addr = args.src_addr;
   uint64_t copy_dst_addr = args.dst_addr;

   if (args.mode == RADV_COPY_MODE_DESERIALIZE) {
      radv_accel_struct_serialization_header_base serialization_header =
         DEREF(REF(radv_accel_struct_serialization_header_base)(args.src_addr));
      copy_src_addr += serialization_header.serialization_size - serialization_header.compacted_size;
   }

   REF(radv_accel_struct_header) header = REF(radv_accel_struct_header)(copy_src_addr);
   uint64_t size = DEREF(header).compacted_size;

   if (args.mode == RADV_COPY_MODE_SERIALIZE) {
      uint64_t serialization_size = DEREF(header).serialization_size;
      copy_dst_addr += serialization_size - size;

      if (global_id == 0) {
         REF(radv_accel_struct_serialization_header_base) ser_header =
            REF(radv_accel_struct_serialization_header_base)(args.dst_addr);
         DEREF(ser_header).serialization_size = serialization_size;
         DEREF(ser_header).compacted_size = size;
      }
   }

   for (uint64_t offset = global_id * 16; offset < size; offset += increment)
      DEREF(REF(uvec4)(copy_dst_addr + offset)) = DEREF(REF(uvec4)(copy_src_addr + offset));
}
