#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "bvh_defines.h"
#define VK_USED_BUILD_FLAGS RADV_HEADER_BUILD_FLAGS
#include "bvh_helpers.h"

layout(push_constant) uniform CONSTS
{
   header_args args;
};

void
main(void)
{
   if (RADV_TEST_BUILD_FLAG_BVH8) {
      REF(radv_accel_struct_header_gfx12) header = REF(radv_accel_struct_header_gfx12)(args.dst);
      DEREF(header).update_dispatch_size[0] =
         ((DEREF(args.src).dst_node_offset - args.internal_nodes_offset) / SIZEOF(radv_gfx12_box_node) + 1) * 8;
      DEREF(header).update_dispatch_size[1] = 1;
      DEREF(header).update_dispatch_size[2] = 1;
   }

   uint32_t compacted_size = args.bvh_offset + DEREF(args.src).dst_node_offset;

   uint32_t serialization_metadata_size = 0;
   if (args.type == VK_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL_KHR)
      serialization_metadata_size = SIZEOF(radv_tlas_serialization_header) + SIZEOF(uint64_t) * args.primitive_count;
   else
      serialization_metadata_size = SIZEOF(radv_blas_serialization_header);

   /* Same layout as radv_init_header(): a BLAS with micromaps serializes one micromap address per primitive. */
   if (args.type == VK_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL_KHR && args.has_micromaps != 0)
      serialization_metadata_size += SIZEOF(radv_blas_serialization_block) + SIZEOF(uint64_t) * args.primitive_count;

   uint32_t serialization_size = compacted_size + align(serialization_metadata_size, 128);

   uint32_t size = serialization_size - serialization_metadata_size;

   DEREF(args.dst).compacted_size = compacted_size;

   DEREF(args.dst).copy_dispatch_size[0] = DIV_ROUND_UP(compacted_size, 16 * 64);
   DEREF(args.dst).copy_dispatch_size[1] = 1;
   DEREF(args.dst).copy_dispatch_size[2] = 1;

   DEREF(args.dst).serialization_size = serialization_size;

   DEREF(args.dst).size = size;
}
