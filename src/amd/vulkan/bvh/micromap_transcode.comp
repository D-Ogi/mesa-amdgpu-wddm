#version 460

#extension GL_GOOGLE_include_directive : require

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define VK_USED_BUILD_FLAGS (0)
#include "bvh_helpers.h"

layout(push_constant) uniform CONSTS
{
   micromap_transcode_args args;
};

#define VK_OPACITY_MICROMAP_FORMAT_2_STATE_EXT 1
#define VK_OPACITY_MICROMAP_FORMAT_4_STATE_EXT 2

struct VkMicromapTriangleKHR {
   uint32_t dataOffset;
   uint16_t subdivisionLevel;
   uint16_t format;
};

TYPE(VkMicromapTriangleKHR, 4);

void
main(void)
{
   uint32_t global_id = gl_GlobalInvocationID.x;

   uint32_t search_index = DIV_ROUND_UP(args.triangle_count, 64) / 2;
   uint32_t search_step = search_index / 2;
   radv_micromap_prefix_sum_partition current_partition;
   while (true) {
      current_partition = DEREF(INDEX(radv_micromap_prefix_sum_partition, args.partitions, search_index));
      if (global_id >= current_partition.start && global_id < current_partition.start + current_partition.local_sum) {
         break;
      } else if (global_id < current_partition.start) {
         search_index -= search_step;
      } else {
         search_index += search_step;
      }
      search_step /= 2;
   }

   VkMicromapTriangleKHR triangle;

   uint32_t data_count;
   uint32_t dword_count;
   int32_t dword_index;

   search_index = min(search_index * 64 + 32, args.triangle_count - 1);
   search_step = 16;
   uint32_t local_prefix_sum = 0;
   for (uint32_t i = 0; i < 6; i++) {
      local_prefix_sum = DEREF(INDEX(uint32_t, args.local_offsets, search_index));

      triangle = DEREF(REF(VkMicromapTriangleKHR)(args.triangles + search_index * args.stride));

      data_count = 1u << (triangle.subdivisionLevel * 2);
      dword_count = max(data_count * 2 / 32, 1);
      dword_index = int32_t(global_id) - int32_t(current_partition.start) - int32_t(local_prefix_sum);

      if (dword_index < 0) {
         search_index -= min(search_step, search_index);
         search_step /= 2;
      } else if (search_index == args.triangle_count - 1 || dword_index < dword_count) {
         break;
      } else {
         search_index = min(search_index + search_step, args.triangle_count - 1);
         search_step /= 2;
      }
   }

   if (dword_index >= dword_count)
      return;

   uint64_t data = args.data + triangle.dataOffset;

   uint32_t src_bits = 2;
   if (triangle.format == VK_OPACITY_MICROMAP_FORMAT_2_STATE_EXT)
      src_bits = 1;

   uint32_t dst = 0;

   /* Reorder the triangles to optimize the index calculation during traversal. */
   for (uint32_t j = 0; j < 16; j++) {
      uint32_t dst_index = dword_index * 16 + j;

      /* Floating point sqrt seems to have enough precision. */
      uint32_t iv_reversed = uint32_t(sqrt(float(dst_index)));
      uint32_t iu = dst_index - iv_reversed * iv_reversed;
      uint32_t iv = (1u << triangle.subdivisionLevel) - 1 - iv_reversed;

      /* Convert the u/v index into the index of the triangle:
       * https://docs.vulkan.org/refpages/latest/refpages/source/VK_KHR_opacity_micromap.html#_reference_code
       */
      uint32_t other_triangle = iu & 1;
      iu /= 2;
      uint32_t iw = (~(iu + iv)) - other_triangle;

      uint32_t b0 = ~(iu ^ iw);
      b0 &= ((1u << triangle.subdivisionLevel) - 1u);
      uint32_t t = (iu ^ iv) & b0;

      uint32_t f = t;
      f ^= f >> 1u;
      f ^= f >> 2u;
      f ^= f >> 4u;
      f ^= f >> 8u;
      uint32_t b1 = ((f ^ iu) & ~b0) | t;

      b0 = (b0 | (b0 << 8u)) & 0x00ff00ffu;
      b0 = (b0 | (b0 << 4u)) & 0x0f0f0f0fu;
      b0 = (b0 | (b0 << 2u)) & 0x33333333u;
      b0 = (b0 | (b0 << 1u)) & 0x55555555u;
      b1 = (b1 | (b1 << 8u)) & 0x00ff00ffu;
      b1 = (b1 | (b1 << 4u)) & 0x0f0f0f0fu;
      b1 = (b1 | (b1 << 2u)) & 0x33333333u;
      b1 = (b1 | (b1 << 1u)) & 0x55555555u;

      uint32_t src_index = (b0 | (b1 << 1u)) & (data_count - 1);

      uint32_t src = DEREF(REF(uint32_t)(data + (src_index * src_bits / 32) * 4));
      src = (src >> ((src_index * src_bits) & 0x1f)) & ((1 << src_bits) - 1);

      dst = dst | (src << (j * 2));
   }

   uint32_t dst_offset = args.data_offset + global_id * SIZEOF(uint32_t);
   DEREF(REF(uint32_t)(args.dst + dst_offset)) = dst;

   if (dword_index == 0) {
      uint32_t header_offset = SIZEOF(radv_accel_struct_header) + search_index * SIZEOF(radv_micromap_triangle_header);
      radv_micromap_triangle_header header;
      header.offset = dst_offset;
      header.level = triangle.subdivisionLevel;
      DEREF(REF(radv_micromap_triangle_header)(args.dst + header_offset)) = header;
   }
}