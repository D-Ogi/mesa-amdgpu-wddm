#version 460

#extension GL_GOOGLE_include_directive : require

#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#define VK_USED_BUILD_FLAGS (0)
#include "bvh_helpers.h"

layout(push_constant) uniform CONSTS
{
   micromap_transcode_args args;
};

#define VK_OPACITY_MICROMAP_FORMAT_2_STATE_EXT 1
#define VK_OPACITY_MICROMAP_FORMAT_4_STATE_EXT 2

struct VkMicromapTriangleKHR {
   uint32_t dataOffset;
   uint16_t subdivisionLevel;
   uint16_t format;
};

TYPE(VkMicromapTriangleKHR, 4);

void
main(void)
{
   uint32_t global_id = gl_GlobalInvocationID.x;

   /* Find the partition of this dword: the last partition that starts at or before it. Both searches halve a closed
    * interval, so they end after log2 steps for every partition and triangle count.
    */
   uint32_t search_index = 0;
   uint32_t search_last = DIV_ROUND_UP(args.triangle_count, 64) - 1;
   while (search_index < search_last) {
      uint32_t middle = (search_index + search_last + 1) / 2;
      if (DEREF(INDEX(radv_micromap_prefix_sum_partition, args.partitions, middle)).start <= global_id)
         search_index = middle;
      else
         search_last = middle - 1;
   }

   radv_micromap_prefix_sum_partition current_partition =
      DEREF(INDEX(radv_micromap_prefix_sum_partition, args.partitions, search_index));
   uint32_t partition_dword = global_id - current_partition.start;

   /* Find the triangle in the same way: the last triangle of the partition whose local offset is at or before the
    * dword.
    */
   search_index *= 64;
   search_last = min(search_index + 63, args.triangle_count - 1);
   while (search_index < search_last) {
      uint32_t middle = (search_index + search_last + 1) / 2;
      if (DEREF(INDEX(uint32_t, args.local_offsets, middle)) <= partition_dword)
         search_index = middle;
      else
         search_last = middle - 1;
   }

   VkMicromapTriangleKHR triangle =
      DEREF(REF(VkMicromapTriangleKHR)(args.triangles + search_index * args.stride));

   uint32_t data_count = 1u << (triangle.subdivisionLevel * 2);
   uint32_t dword_count = max(data_count * 2 / 32, 1);
   uint32_t dword_index = partition_dword - DEREF(INDEX(uint32_t, args.local_offsets, search_index));

   if (dword_index >= dword_count)
      return;

   uint64_t data = args.data + triangle.dataOffset;

   uint32_t src_bits = 2;
   if (triangle.format == VK_OPACITY_MICROMAP_FORMAT_2_STATE_EXT)
      src_bits = 1;

   uint32_t dst = 0;
   uint32_t states = 0;

   /* Reorder the triangles to optimize the index calculation during traversal. */
   for (uint32_t j = 0; j < 16; j++) {
      uint32_t dst_index = dword_index * 16 + j;

      /* Floating point sqrt seems to have enough precision. */
      uint32_t iv_reversed = uint32_t(sqrt(float(dst_index)));
      uint32_t iu = dst_index - iv_reversed * iv_reversed;
      uint32_t iv = (1u << triangle.subdivisionLevel) - 1 - iv_reversed;

      /* Convert the u/v index into the index of the triangle:
       * https://docs.vulkan.org/refpages/latest/refpages/source/VK_KHR_opacity_micromap.html#_reference_code
       */
      uint32_t other_triangle = iu & 1;
      iu /= 2;
      uint32_t iw = (~(iu + iv)) - other_triangle;

      uint32_t b0 = ~(iu ^ iw);
      b0 &= ((1u << triangle.subdivisionLevel) - 1u);
      uint32_t t = (iu ^ iv) & b0;

      uint32_t f = t;
      f ^= f >> 1u;
      f ^= f >> 2u;
      f ^= f >> 4u;
      f ^= f >> 8u;
      uint32_t b1 = ((f ^ iu) & ~b0) | t;

      b0 = (b0 | (b0 << 8u)) & 0x00ff00ffu;
      b0 = (b0 | (b0 << 4u)) & 0x0f0f0f0fu;
      b0 = (b0 | (b0 << 2u)) & 0x33333333u;
      b0 = (b0 | (b0 << 1u)) & 0x55555555u;
      b1 = (b1 | (b1 << 8u)) & 0x00ff00ffu;
      b1 = (b1 | (b1 << 4u)) & 0x0f0f0f0fu;
      b1 = (b1 | (b1 << 2u)) & 0x33333333u;
      b1 = (b1 | (b1 << 1u)) & 0x55555555u;

      uint32_t src_index = (b0 | (b1 << 1u)) & (data_count - 1);

      uint32_t src = DEREF(REF(uint32_t)(data + (src_index * src_bits / 32) * 4));
      src = (src >> ((src_index * src_bits) & 0x1f)) & ((1 << src_bits) - 1);

      dst = dst | (src << (j * 2));

      /* Levels 0 and 1 fill only part of the dword. */
      if (dst_index < data_count)
         states |= 1u << src;
   }

   uint32_t dst_offset = args.data_offset + global_id * SIZEOF(uint32_t);
   DEREF(REF(uint32_t)(args.dst + dst_offset)) = dst;

   uint32_t header_offset = SIZEOF(radv_accel_struct_header) + search_index * SIZEOF(radv_micromap_triangle_header);
   REF(radv_micromap_triangle_header) header = REF(radv_micromap_triangle_header)(args.dst + header_offset);

   uint32_t level_bits = states << RADV_MICROMAP_STATES_SHIFT;
   if (dword_index == 0) {
      DEREF(header).offset = dst_offset;
      level_bits |= uint32_t(triangle.subdivisionLevel);
   }

   /* The build clears the headers before this pass, and all dwords of a triangle add their states. A subgroup
    * merges the bits of each of its triangles first, so that a large micromap does not need one atomic per dword.
    */
   while (true) {
      uint32_t first_triangle = subgroupBroadcastFirst(search_index);
      if (search_index == first_triangle) {
         uint32_t merged_bits = subgroupOr(level_bits);
         if (subgroupElect())
            atomicOr(DEREF(header).level, merged_bits);
         break;
      }
   }
}